{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/jigs_256.ans",
    "padding": { "top": 3 }
},
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "│ ├ Terminal",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ ├ Shell",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "│ └ Font",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 Processor",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰻑 GPU",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󰍹 Built-in Display",
      "keyColor": "green",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆 Memory",
      "keyColor": "green",
      "format": "{used} Used / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡 Swap",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐 Uptime",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "│ ├󰁹 Batt",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "sound",
      "key": ""│ ├ AUDIO",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": "│ ├󰩟 Local IP",
      "keyColor": "green",
      "compact": true
    },
    {
      "type": "publicip",
      "key": "│ └󰩠 Public IP",
      "keyColor": "green"
    },
    {
      "type": "weather",
      "key": "├󰖐 Weather",
      "keyColor": "cyan",
      "timeout": 1000
    },	
    {
      "type": "command",
      "key": "├󰒄 Tailscale",
      "keyColor": "magenta",
      "shell": "powershell",
      "param": "-NoProfile -Command",
      "text": "$ts = tailscale status --json 2>$null | ConvertFrom-Json; if ($ts -and $ts.Self) { $ip = $ts.Self.TailscaleIPs[0]; $exit = $ts.ExitNodeStatus.TailscaleIPs[0]; if ($exit) { \"$ip (Exit: $exit)\" } else { \"$ip (Connected)\" } } else { 'Offline' }"
    },
    {
      "type": "command",
      "key": "├󰧑 Local AI",
      "keyColor": "magenta",
      "shell": "powershell",
      "param": "-NoProfile -Command",
      "text": "$m = (curl.exe -s --max-time 1 http://localhost:11434/api/ps 2>$null | ConvertFrom-Json).models.name; if ($m) { \"Ollama ($($m -join ', '))\" } else { $l = (curl.exe -s --max-time 1 http://localhost:1234/v1/models 2>$null | ConvertFrom-Json).data.id; if ($l) { \"LM Studio ($($l[0]))\" } else { 'Offline' } }"
    },
    {
      "type": "command",
      "key": "├󰋽 Advice",
      "keyColor": "magenta",
      "shell": "powershell",
      "param": "-NoProfile -Command",
      "text": "(curl.exe -s --max-time 1 https://api.adviceslip.com/advice 2>$null | ConvertFrom-Json).slip.advice"
    },
    {
      "type": "command",
      "key": "└󰍉 JOKE",
      "keyColor": "cyan",
      "shell": "powershell",
      "param": "-NoProfile -Command",
      "text": "curl.exe -s --max-time 1 \"https://v2.jokeapi.dev/joke/Programming?blacklistFlags=nsfw,religious,political,racist,sexist,explicit&format=txt\""
    },
    "break"
  ]
}
