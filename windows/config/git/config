[core]
  editor = code --wait
  longpaths = true
  autocrlf = true
  filemode = false
  trustctime = false
  checkStat = minimal
  excludesfile = ~/.config/git/ignore
  fscache = true
  fsmonitor = true
  untrackedcache = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[diff]
  tool = bc4
  guitool = bc
  astextplain = astextplain
[merge]
  tool = bc4
  guitool = bc
[user]
  name = voltaire-toledo
  email = 203450225+voltaire-toledo@users.noreply.github.com
[pull]
  rebase = false
[fetch]
  prune = false
[rebase]
  autoStash = false
  autosquash = false
  updateRefs = false
[init]
  defaultbranch = main
