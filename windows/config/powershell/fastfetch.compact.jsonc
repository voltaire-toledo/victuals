{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "Windows",
    "padding": {
      "left": 0,
      "right": 1,
      "top": 0
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " "
    },
    {
      "type": "separator",
      "string": "-",
      "times": 24
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "users",
      "key": "Users"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "IP"
    },
    {
      "type": "publicip",
      "key": "Public Gateway IP",
      "timeout": 1000
    },
    {
      "type": "separator",
      "string": "-",
      "times": 24
    },
    {
      "type": "command",
      "key": "Current Weather",
      "shell": "powershell",
      "param": "-NoProfile -Command",
      "text": "(curl.exe -s \"wttr.in?u&format=%l:+%c+%t\") -replace \",.*:\", \":\""
    },
    {
      "type": "battery",
      "key": "Battery"
    }
  ]
}
