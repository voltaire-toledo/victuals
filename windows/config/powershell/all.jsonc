{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "Windows",
    "padding": {
      "left": 0,
      "right": 1,
      "top": 0
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "processes",
    "packages",
    "shell",
    "display",
    "brightness",
    "monitor",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "cpuusage",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "player",
    "media",
    "localip",
    "publicip",
    "wifi",
    "users",
    "bluetooth",
    "sound",
    "camera",
    "gamepad",
    "weather",
    "netio",
    "diskio",
    "physicaldisk",
    "version",
    "break",
    "colors"
  ]
}
