{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "Windows",
    "padding": {
      "left": 0,
      "right": 1,
      "top": 0
    }
  },
  "display": {
    "separator": " -> ",
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "User"
    },
    {
      "type": "separator",
      "string": "═"
    },
    {
      "type": "host",
      "key": "Machine"
    },
    {
      "type": "os",
      "key": "System"
    },
    {
      "type": "uptime",
      "key": "Alive"
    },
    "break",
    {
      "type": "packages",
      "key": "Software"
    },
    {
      "type": "display",
      "key": "Screen"
    },
    {
      "type": "battery",
      "key": "Power"
    },
    "break",
    {
      "type": "cpu",
      "key": "Cores"
    },
    {
      "type": "gpu",
      "key": "Draw"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    "break",
    {
      "type": "localip",
      "key": "Local"
    },
    {
      "type": "publicip",
      "key": "Public",
      "timeout": 1000
    },
    {
      "type": "command",
      "key": "Weather",
      "text": "curl -s 'wttr.in?format=3'"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
