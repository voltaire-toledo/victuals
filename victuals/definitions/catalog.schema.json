{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voltaire-toledo/victuals/main/victuals/definitions/catalog.schema.json",
  "title": "Victuals target-neutral catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "catalogType", "items"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "kind": { "const": "catalog" },
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "catalogType": { "enum": ["applications", "policies", "profiles"] },
    "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "kind", "name", "description", "dependencies"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["package", "operation", "profile", "suite"] }, "packageType": { "type": "string" }, "operationType": { "type": "string" }, "profileType": { "type": "string" }, "suiteType": { "type": "string" }, "group": { "type": "string" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "dependencies": { "type": "array", "items": { "type": "string" } }, "applicationIds": { "type": "array", "items": { "type": "string" } }, "policyIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } }
  }
}
