;; ==============================================================================
;; Kanata Homerow Mods Configuration (Urob's Timeless Logic) v1.3
;; Layout: CMAS (Ctrl, Meta, Alt, Shift) mirrored on both hands
;; - when a home row mod activates tap, the home row mods are disabled
;;   while continuing to type rapidly
;; - tap-hold-release-keys helps make the hold action more responsive
;; - pressing another key on the same half of the keyboard
;;   as the home row mod will activate an early tap action
;; ==============================================================================
;; GitHub discussion on more advanced tap-hold improvements:
;;
;;    https://github.com/jtroo/kanata/discussions/1455
;;
;; Configuration guide documentation on all tap-hold options:
;;
;;    https://github.com/jtroo/kanata/blob/main/docs/config.adoc#tap-hold
;; ==============================================================================

(defcfg
  ;; Allows keys not explicitly mapped in defsrc to pass through normally.
  ;; Crucial for maintainability so we don't have to map the entire board.
  process-unmapped-keys yes

  ;; Instructs Kanata to ignore the QMK board and process everything else.
  linux-dev-names-include (
  "AT Translated Set 2 keyboard"
  )
)

;; ------------------------------------------------------------------------------
;; 1. Source Keys
;; NEW: skip irrelevant keys
;; ------------------------------------------------------------------------------
(defsrc
  q         w      e      r      t         y      u      i      o      p
  caps      a      s      d      f      g  h      j      k      l      scln
  z         x      c      v      b         n      m      comm   .      /
)

;; ------------------------------------------------------------------------------
;; 2. Timings & Positional Lists
;; Note: consider using different time values for your different fingers.
;; For example, your pinkies might be slower to release keys and index
;; fingers faster.
;; ------------------------------------------------------------------------------
(defvar
  ;; Urob favors generous tapping terms because the positional check handles the rest.
  tap-time  200
  hold-time 150

  ;; Positional lists: defines which keys on the opposite hand can trigger a modifier.
  left-hand-keys (
    q w e r t
    caps a s d f g
    z x c v b
  )

  right-hand-keys (
    y u i o p
    h j k l scln
    n m comm . /
  )
)

;; ------------------------------------------------------------------------------
;; 3. Base Layer - Moved higher up the sequencial read process
;; Applies the aliases to the home row and passes through the rest transparently.
;; ------------------------------------------------------------------------------
(deflayer base
  _         _      _      _      _         _      _      _      _      _
  @caps-nav @a-ctl @s-met @d-alt @f-sft _  _      @j-sft @k-alt @l-met @scln-ctl
  _         _      _      _      _         _      _      _      _      _
)

(deflayer nomods
  _         _      _      _      _         _      _      _      _      _
  _         a      s      d      f      _  _      j      k      l      ;
  _         _      _      _      _         _      _      _      _      _
)

(deffakekeys
  to-base (layer-switch base)
)

;; ------------------------------------------------------------------------------
;; 3. Aliases (The Logic)
;; tap-hold-release-keys $tap $hold $tap-action $hold-action $trigger-keys
;; ------------------------------------------------------------------------------
(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; Left Hand (CMAS)
  a-ctl (tap-hold-release-keys $tap-time $hold-time (multi a @tap) lctl $left-hand-keys)
  s-met (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lmet $left-hand-keys)
  d-alt (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lalt $left-hand-keys)
  f-sft (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)

  ;; Right Hand (Mirrored: SAMC)
  j-sft (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  k-alt (tap-hold-release-keys $tap-time $hold-time (multi k @tap) ralt $right-hand-keys)
  l-met (tap-hold-release-keys $tap-time $hold-time (multi l @tap) rmet $right-hand-keys)
  scln-ctl (tap-hold-release-keys $tap-time $hold-time (multi scln @tap) rctl $right-hand-keys)

  ;; Layer Toggles
  caps-nav (tap-hold $tap-time $hold-time esc (layer-toggle nav))
)



;; ------------------------------------------------------------------------------
;; 5. Navigation Layer
;; Triggered by holding Caps Lock. Left hand remains transparent for mod access.
;; ------------------------------------------------------------------------------
(deflayer nav
  _         _      _      _      _         _      del    up     bspc   _
  _         @a-ctl @s-met @d-alt @f-sft _  home   left   down   right  end
  _         _      _      _      _         pgup   pgdn   _      _      -
)
