#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: battdrain [avg|diag|--help]

Battery information:
  1. Current status   battdrain
     Shows battery percentage, charge state, drain rate, and time remaining
     using upower.

  2. Average drain    battdrain avg
     Samples system power consumption and reports the average wattage using
     powerstat.

  3. Drain causes     battdrain diag
     Opens powertop to identify power-hungry processes, devices, and wakeups.

Options:
  -h, --help, help    Show this help text.

Dependencies:
  sudo apt install upower powerstat powertop
EOF
}

require_command() {
    local command_name="$1"
    local package_name="${2:-$1}"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'battdrain: required command not found: %s\n' "$command_name" >&2
        printf 'Install it with: sudo apt install %s\n' "$package_name" >&2
        exit 127
    fi
}

show_battery() {
    require_command upower

    local battery
    battery="$(upower -e | awk '/\/battery(_|$)/ { print; exit }')"

    if [[ -z "$battery" ]]; then
        printf 'battdrain: no battery was found by upower.\n' >&2
        exit 1
    fi

    upower -i "$battery"
}

show_average() {
    require_command powerstat

    if command -v sudo >/dev/null 2>&1 && [[ "${EUID}" -ne 0 ]]; then
        sudo powerstat -d 0
    else
        powerstat -d 0
    fi
}

show_diagnostics() {
    require_command powertop

    if command -v sudo >/dev/null 2>&1 && [[ "${EUID}" -ne 0 ]]; then
        sudo powertop
    else
        powertop
    fi
}

case "${1:-}" in
    '')
        show_battery
        ;;
    avg)
        [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
        show_average
        ;;
    diag)
        [[ "$#" -eq 1 ]] || { usage >&2; exit 2; }
        show_diagnostics
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        printf 'battdrain: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
