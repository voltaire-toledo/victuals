{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "vscodium",
  "title": "Vscodium",
  "description": "Linutil Store application definition for vscodium.",
  "kind": "application",
  "state": "draft",
  "category": "linutil-store",
  "categories": [
    "developer"
  ],
  "tags": [],
  "availability": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "apt",
    "package": "codium",
    "scope": "user"
  },
  "actions": [
    {
      "id": "vscodium.install",
      "phase": "install",
      "executor": "apt",
      "run": [
        "codium"
      ]
    }
  ],
  "validation": [
    {
      "id": "vscodium.ready",
      "check": [
        "command",
        "vscodium"
      ],
      "expected": "vscodium is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ],
  "links": [
    "https://linutil.christitus.com/userguide/store/"
  ]
}
