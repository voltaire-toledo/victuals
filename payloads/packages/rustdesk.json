{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "rustdesk",
  "title": "Rustdesk",
  "description": "Initial baseline payload definition for rustdesk.",
  "kind": "application",
  "state": "draft",
  "category": "baseline",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "flatpak",
    "package": "com.rustdesk.RustDesk",
    "scope": "system"
  },
  "actions": [
    {
      "id": "rustdesk.install",
      "phase": "install",
      "executor": "flatpak",
      "run": [
        "com.rustdesk.RustDesk"
      ]
    }
  ],
  "validation": [
    {
      "id": "rustdesk.command",
      "check": [
        "command",
        "rustdesk"
      ],
      "expected": "rustdesk is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

