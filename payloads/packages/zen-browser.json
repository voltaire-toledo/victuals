{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "zen-browser",
  "title": "Zen Browser",
  "description": "Linutil Store application definition for zen-browser.",
  "kind": "application",
  "state": "draft",
  "category": "linutil-store",
  "categories": [
    "browser"
  ],
  "tags": [],
  "availability": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "flatpak",
    "package": "app.zen_browser.zen",
    "scope": "user"
  },
  "actions": [
    {
      "id": "zen-browser.install",
      "phase": "install",
      "executor": "flatpak",
      "run": [
        "app.zen_browser.zen"
      ]
    }
  ],
  "validation": [
    {
      "id": "zen-browser.ready",
      "check": [
        "command",
        "zen-browser"
      ],
      "expected": "zen-browser is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ],
  "links": [
    "https://linutil.christitus.com/userguide/store/"
  ]
}
