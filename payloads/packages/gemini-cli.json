{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "gemini-cli",
  "title": "Gemini Cli",
  "description": "Initial optional payload definition for gemini-cli.",
  "kind": "application",
  "state": "draft",
  "category": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "npm",
    "package": "@google/gemini-cli",
    "scope": "user"
  },
  "actions": [
    {
      "id": "gemini-cli.install",
      "phase": "install",
      "executor": "shell",
      "run": [
        "pnpm",
        "add",
        "-g",
        "@google/gemini-cli"
      ]
    }
  ],
  "validation": [
    {
      "id": "gemini-cli.command",
      "check": [
        "command",
        "gemini-cli"
      ],
      "expected": "gemini-cli is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

