{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "docker",
  "title": "Docker",
  "description": "Linutil Store application definition for docker.",
  "kind": "service",
  "state": "draft",
  "category": "linutil-store",
  "categories": [
    "developer"
  ],
  "tags": [],
  "availability": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "apt",
    "package": "docker-ce",
    "scope": "system"
  },
  "actions": [
    {
      "id": "docker.install",
      "phase": "install",
      "executor": "apt",
      "run": [
        "docker-ce"
      ]
    }
  ],
  "validation": [
    {
      "id": "docker.ready",
      "check": [
        "command",
        "docker"
      ],
      "expected": "docker is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ],
  "links": [
    "https://linutil.christitus.com/userguide/store/"
  ]
}
