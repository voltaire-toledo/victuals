{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "thunderbird",
  "title": "Thunderbird",
  "description": "Initial optional payload definition for thunderbird.",
  "kind": "application",
  "state": "draft",
  "category": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "flatpak",
    "package": "org.mozilla.Thunderbird",
    "scope": "user"
  },
  "actions": [
    {
      "id": "thunderbird.install",
      "phase": "install",
      "executor": "flatpak",
      "run": [
        "org.mozilla.Thunderbird"
      ]
    }
  ],
  "validation": [
    {
      "id": "thunderbird.command",
      "check": [
        "command",
        "thunderbird"
      ],
      "expected": "thunderbird is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

