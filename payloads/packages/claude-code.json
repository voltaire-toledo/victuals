{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "claude-code",
  "title": "Claude Code",
  "description": "Initial optional payload definition for claude-code.",
  "kind": "application",
  "state": "draft",
  "category": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "npm",
    "package": "@anthropic-ai/claude-code",
    "scope": "user"
  },
  "actions": [
    {
      "id": "claude-code.install",
      "phase": "install",
      "executor": "shell",
      "run": [
        "pnpm",
        "add",
        "-g",
        "@anthropic-ai/claude-code"
      ]
    }
  ],
  "validation": [
    {
      "id": "claude-code.command",
      "check": [
        "command",
        "claude-code"
      ],
      "expected": "claude-code is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

