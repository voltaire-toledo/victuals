{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "gum",
  "title": "Gum",
  "description": "Initial bootstrap payload definition for gum.",
  "kind": "tool",
  "state": "draft",
  "category": "bootstrap",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "apt",
    "package": "gum",
    "scope": "system"
  },
  "actions": [
    {
      "id": "gum.install",
      "phase": "bootstrap",
      "executor": "apt",
      "run": [
        "gum"
      ]
    }
  ],
  "validation": [
    {
      "id": "gum.command",
      "check": [
        "command",
        "gum"
      ],
      "expected": "gum is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

