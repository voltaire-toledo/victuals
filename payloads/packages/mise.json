{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "mise",
  "title": "Mise",
  "description": "User-local runtime manager bootstrap.",
  "kind": "tool",
  "state": "draft",
  "category": "bootstrap",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "script",
    "package": "mise",
    "scope": "system"
  },
  "actions": [
    {
      "id": "mise.install",
      "phase": "bootstrap",
      "executor": "script",
      "run": [
        "mise"
      ]
    }
  ],
  "validation": [
    {
      "id": "mise.ready",
      "check": [
        "command",
        "mise"
      ],
      "expected": "mise is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}
