{
  "$schema": "../../schemas/v1/package.schema.json",
  "id": "opencode",
  "title": "Opencode",
  "description": "Initial optional payload definition for opencode.",
  "kind": "application",
  "state": "draft",
  "category": "optional",
  "platforms": [
    "linux"
  ],
  "dependencies": [],
  "delivery": {
    "manager": "npm",
    "package": "opencode-ai",
    "scope": "user"
  },
  "actions": [
    {
      "id": "opencode.install",
      "phase": "install",
      "executor": "shell",
      "run": [
        "pnpm",
        "add",
        "-g",
        "opencode-ai"
      ]
    }
  ],
  "validation": [
    {
      "id": "opencode.command",
      "check": [
        "command",
        "opencode"
      ],
      "expected": "opencode is available",
      "required": true
    }
  ],
  "metrics": [
    "package-queued",
    "package-fetched",
    "package-installed",
    "validation-passed",
    "validation-failed"
  ]
}

