{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "firewalld-baseline",
  "title": "FirewallD Baseline",
  "description": "Linutil-inspired FirewallD Baseline operation definition.",
  "kind": "feature",
  "state": "draft",
  "distro": "fedora",
  "platforms": [
    "linux"
  ],
  "categories": [
    "feature",
    "security"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "firewalld-baseline.apply",
      "phase": "configure",
      "executor": "apt",
      "run": [
        "firewalld",
        "enable"
      ]
    }
  ],
  "validation": [
    {
      "id": "firewalld-baseline.validation",
      "check": [
        "firewall-cmd",
        "--state"
      ],
      "expected": "FirewallD Baseline is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
