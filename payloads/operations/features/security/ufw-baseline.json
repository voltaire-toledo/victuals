{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "ufw-baseline",
  "title": "UFW Firewall Baseline",
  "description": "Linutil-inspired UFW Firewall Baseline operation definition.",
  "kind": "feature",
  "state": "draft",
  "distro": "any-linux",
  "platforms": [
    "linux"
  ],
  "categories": [
    "feature",
    "security"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "ufw-baseline.apply",
      "phase": "configure",
      "executor": "apt",
      "run": [
        "ufw",
        "enable"
      ]
    }
  ],
  "validation": [
    {
      "id": "ufw-baseline.validation",
      "check": [
        "ufw",
        "status",
        "verbose"
      ],
      "expected": "UFW Firewall Baseline is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
