{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "us-locale-setup",
  "title": "US Locale Setup",
  "description": "Linutil-inspired US Locale Setup operation definition.",
  "kind": "utility",
  "state": "draft",
  "distro": "any-linux",
  "platforms": [
    "linux"
  ],
  "categories": [
    "utility",
    "locale"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "us-locale-setup.apply",
      "phase": "configure",
      "executor": "shell",
      "run": [
        "configure-locale",
        "en_US.UTF-8"
      ]
    }
  ],
  "validation": [
    {
      "id": "us-locale-setup.validation",
      "check": [
        "locale",
        "LANG"
      ],
      "expected": "US Locale Setup is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
