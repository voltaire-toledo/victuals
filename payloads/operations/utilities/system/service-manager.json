{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "service-manager",
  "title": "Service Manager",
  "description": "Linutil-inspired Service Manager operation definition.",
  "kind": "utility",
  "state": "draft",
  "distro": "any-linux",
  "platforms": [
    "linux"
  ],
  "categories": [
    "utility",
    "performance"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "service-manager.apply",
      "phase": "configure",
      "executor": "systemd",
      "run": [
        "manage-service"
      ]
    }
  ],
  "validation": [
    {
      "id": "service-manager.validation",
      "check": [
        "systemctl",
        "--failed"
      ],
      "expected": "Service Manager is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
