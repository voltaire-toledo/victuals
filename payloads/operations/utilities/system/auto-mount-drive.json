{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "auto-mount-drive",
  "title": "Auto Mount Drive",
  "description": "Linutil-inspired Auto Mount Drive operation definition.",
  "kind": "utility",
  "state": "draft",
  "distro": "any-linux",
  "platforms": [
    "linux"
  ],
  "categories": [
    "utility",
    "storage"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "auto-mount-drive.apply",
      "phase": "configure",
      "executor": "systemd",
      "run": [
        "configure-automount"
      ]
    }
  ],
  "validation": [
    {
      "id": "auto-mount-drive.validation",
      "check": [
        "systemctl",
        "--user",
        "--failed"
      ],
      "expected": "Auto Mount Drive is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
