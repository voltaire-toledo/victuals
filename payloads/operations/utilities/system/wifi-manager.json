{
  "$schema": "../../schemas/v1/operation.schema.json",
  "id": "wifi-manager",
  "title": "WiFi Manager",
  "description": "Linutil-inspired WiFi Manager operation definition.",
  "kind": "utility",
  "state": "draft",
  "distro": "any-linux",
  "platforms": [
    "linux"
  ],
  "categories": [
    "utility",
    "connectivity"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "wifi-manager.apply",
      "phase": "configure",
      "executor": "shell",
      "run": [
        "manage-wifi"
      ]
    }
  ],
  "validation": [
    {
      "id": "wifi-manager.validation",
      "check": [
        "nmcli",
        "radio",
        "wifi"
      ],
      "expected": "WiFi Manager is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
