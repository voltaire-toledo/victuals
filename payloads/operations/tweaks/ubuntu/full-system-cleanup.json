{
  "$schema": "../../../schemas/v1/operation.schema.json",
  "id": "full-system-cleanup",
  "title": "Full System Cleanup",
  "description": "Linutil-inspired Full System Cleanup operation definition.",
  "kind": "tweak",
  "state": "draft",
  "distro": "ubuntu",
  "platforms": [
    "linux"
  ],
  "categories": [
    "tweak",
    "performance"
  ],
  "tags": [
    "linutil-derived"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "full-system-cleanup.apply",
      "phase": "configure",
      "executor": "apt",
      "run": [
        "apt-get",
        "autoremove",
        "--purge",
        "-y"
      ]
    }
  ],
  "validation": [
    {
      "id": "full-system-cleanup.validation",
      "check": [
        "apt-get",
        "-s",
        "autoremove"
      ],
      "expected": "Full System Cleanup is applied or available",
      "required": false
    }
  ],
  "links": [
    "https://linutil.christitus.com/userguide/features/",
    "https://linutil.christitus.com/userguide/tweaks/"
  ]
}
