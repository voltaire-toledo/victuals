window-width = 110
window-height = 40
# window-save-state = never

font-family = "JuliaMonoForced Nerd Font"
font-size = 14

# theme = "Catppuccin Mocha"
# theme = "Sea Shells"
# theme = "GitHub Dark Default"
theme = Cobalt Next
background-opacity = 0.80
background-blur = true

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# audio = /usr/share/sounds/Yaru/stereo/bell.oga

# Misc: Fixes issue with dimension overlay sticking (v1.3.1 verified)
resize-overlay = never

# Fix issues with MacOS title bar
macos-titlebar-style = transparent

# Keybinds
## Ghostty
keybind = ctrl+shift+,=reload_config
keybind = ctrl+,=open_config

## Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
confirm-close-surface = false
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

## Windows & Tabs [
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+w=close_surface

## Search
keybind = ctrl+shift+f=start_search
keybind = escape=end_search

# Split Panes [ctrl] [alt] b, then { = | " | % }
# keybind = ctrl+alt+b>equal=new_split:auto
# keybind = ctrl+alt+b>"=new_split:down
# keybind = ctrl+alt+b>%=new_split:right
# keybind = ctrl+alt+b>z=toggle_split_zoom

# Pane Navigation: [ctrl] [alt] b, then  
# keybind = ctrl+alt+b>o=goto_split:next
# keybind = ctrl+alt+b>;=goto_split:previous
# keybind = ctrl+alt+k=resize_split:down,5
# keybind = ctrl+alt+i=resize_split:up,5
# keybind = ctrl+alt+l=resize_split:right,10
# keybind = ctrl+alt+j=resize_split:left,10
# keybind = ctrl+shift+0=equalize_splits

## Misc
# TIP:
# - [ctrl][shift]p will toggle the Inspector
# - Use the GTK Inspector for undocumented changes or behaviors
# - Use the +list-themes cli parameter to get the theme names`
