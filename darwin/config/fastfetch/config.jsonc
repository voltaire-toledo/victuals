{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/jigs_256.ans",
    "padding": { "top": 3 }
},
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " ├ Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " ├󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": " ├ OS Installed",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -f %B /var/db/.AppleSetupDone 2>/dev/null || stat -f %B /); birth_date=$(date -r $birth_install +\"%b %d, %Y\"); current=$(date +%s); days_difference=$(((current - birth_install) / 86400)); echo \"$birth_date ($days_difference days)\""
    },
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": " ├ Terminal",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " ├ Shell",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": " ├󰀻",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": " └ Font",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "green",
      "format": "{name~0,26})"
    },
    {
      "type": "cpu",
      "key": " ├󰻠 Processor",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": " ├󰍹 Built-in Display",
      "keyColor": "green",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": " ├󰾆 Memory",
      "keyColor": "green",
      "format": "{used} Used / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": " ├󰓡 Swap",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": " ├󰅐 Uptime",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": " ├󰋊 Disk",
      "keyColor": "green",
      "format": "{size-used} Used / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": " ├󰁹 Batt",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": " ├󰩟 Local IP",
      "keyColor": "green",
      "compact": true
    },
    {
      "type": "publicip",
      "key": " └󰩠 Public IP",
      "keyColor": "green"
    },
    {
      "type": "weather",
      "key": "󰖐 Weather",
      "keyColor": "magenta",
      "timeout": 1000
    },	
    {
      "type": "command",
      "key": "󰒄 Tailscale",
      "keyColor": "magenta",
      "text": "ts=$(tailscale status --json 2>/dev/null); if [ -n \"$ts\" ]; then echo \"$ts\" | python3 -c \"import sys, json; d=json.load(sys.stdin); ip=(d.get('Self') or {}).get('TailscaleIPs', [''])[0]; exit=((d.get('ExitNodeStatus') or {}).get('TailscaleIPs') or [''])[0] if d.get('ExitNodeStatus') else ''; print(f'{ip} (Exit: {exit})' if exit else f'{ip} (Connected)' if ip else 'Offline')\" 2>/dev/null || echo 'Offline'; else echo 'Offline'; fi"
    },
    {
      "type": "command",
      "key": "󰧑 Local AI",
      "keyColor": "magenta",
      "text": "m=$(curl -s --max-time 1 http://localhost:11434/api/ps 2>/dev/null | python3 -c \"import sys, json; print(', '.join([x['name'] for x in json.load(sys.stdin).get('models', [])]))\" 2>/dev/null); if [ -n \"$m\" ]; then echo \"Ollama ($m)\"; else l=$(curl -s --max-time 1 http://localhost:1234/v1/models 2>/dev/null | python3 -c \"import sys, json; print(json.load(sys.stdin).get('data', [{}])[0].get('id', ''))\" 2>/dev/null); if [ -n \"$l\" ]; then echo \"LM Studio ($l)\"; else echo \"Offline\"; fi; fi"
    },
    {
      "type": "command",
      "key": "󰋽 Advice",
      "keyColor": "magenta",
      "text": "curl -s --max-time 1 https://api.adviceslip.com/advice 2>/dev/null | python3 -c \"import sys, json; print(json.load(sys.stdin).get('slip', {}).get('advice', ''))\" 2>/dev/null"
    },
    {
      "type": "command",
      "key": "󰍉 JOKE",
      "keyColor": "magenta",
      "text": "curl -s --max-time 1 'https://v2.jokeapi.dev/joke/Programming?blacklistFlags=nsfw,religious,political,racist,sexist,explicit&format=txt&type=single' | tr '\\n' ' ' | sed 's/  */ /g'"
    },
      "break"
  ]
}
