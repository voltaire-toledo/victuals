{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voltaire-toledo/victuals/main/schemas/v1/package.schema.json",
  "title": "Victuals package instruction",
  "description": "A lazily fetched, platform-aware installation and validation recipe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "state", "platforms", "dependencies", "delivery", "actions", "validation"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": { "enum": ["package", "application", "tool", "service", "configuration"] },
    "state": { "enum": ["draft", "review", "verified", "retired"] },
    "category": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "availability": { "enum": ["bootstrap", "baseline", "optional", "profile-only", "retired"] },
    "platforms": { "type": "array", "items": { "enum": ["linux", "darwin", "windows"] }, "minItems": 1, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "delivery": { "$ref": "#/$defs/delivery" },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" }, "minItems": 1 },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/validation" }, "minItems": 1 },
    "metrics": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "string", "format": "uri-reference" } }
  },
  "$defs": {
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string" }, "platforms": { "type": "array", "items": { "type": "string" } }, "optional": { "type": "boolean" } }
    },
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["manager"],
      "properties": {
        "manager": { "enum": ["apt", "deb", "appimage", "flatpak", "brew", "mise", "pnpm", "npm", "pip", "curl", "script", "task", "native"] },
        "package": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "artifact": { "type": "string" },
        "scope": { "enum": ["system", "user"] }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["id", "phase", "executor"],
      "properties": {
        "id": { "type": "string" },
        "phase": { "enum": ["bootstrap", "install", "configure", "remove", "export"] },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "executor": { "enum": ["apt", "deb", "appimage", "flatpak", "brew", "mise", "curl", "script", "task", "shell"] },
        "run": { "type": "array", "items": { "type": "string" } },
        "download": { "$ref": "#/$defs/download" },
        "task": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "when": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string" } }
      }
    },
    "download": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": { "url": { "type": "string", "format": "uri-template" }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "filename": { "type": "string" } }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["id", "check"],
      "properties": { "id": { "type": "string" }, "check": { "type": "array", "items": { "type": "string" } }, "expected": { "type": "string" }, "required": { "type": "boolean", "default": true } }
    }
  }
}
