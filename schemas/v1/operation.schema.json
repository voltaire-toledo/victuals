{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voltaire-toledo/victuals/main/schemas/v1/operation.schema.json",
  "title": "Victuals system operation",
  "description": "A declarative tweak, feature, or utility operation. It is not an application package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "platforms", "actions", "validation"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "kind": { "enum": ["tweak", "feature", "utility"] },
    "state": { "enum": ["draft", "review", "verified", "retired"] },
    "distro": { "enum": ["ubuntu", "debian", "fedora", "arch", "alpine", "any-linux"] },
    "platforms": { "type": "array", "items": { "enum": ["linux", "darwin", "windows"] }, "minItems": 1, "uniqueItems": true },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" }, "minItems": 1 },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/validation" }, "minItems": 1 },
    "links": { "type": "array", "items": { "type": "string", "format": "uri-reference" } }
  },
  "$defs": {
    "action": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "executor"], "properties": { "id": { "type": "string" }, "phase": { "enum": ["inspect", "install", "configure", "remove", "export"] }, "executor": { "enum": ["apt", "brew", "script", "task", "shell", "systemd", "gsettings", "sysctl", "modprobe"] }, "run": { "type": "array", "items": { "type": "string" } }, "platforms": { "type": "array", "items": { "type": "string" } }, "when": { "type": "string" }, "requires": { "type": "array", "items": { "type": "string" } } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["id", "check"], "properties": { "id": { "type": "string" }, "check": { "type": "array", "items": { "type": "string" } }, "expected": { "type": "string" }, "required": { "type": "boolean", "default": true } } }
  }
}
